         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">LM393 - Low Offset Voltage Dual Comparators</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The LM393 series are dual independent precision voltage comparators capable of single or split supply operation. These devices are designed to permit a common mode rangeâ€toâ€ground level with single supply operation. Input offset voltage specifications as low as 2.0 mV make this device an excellent selection for many applications in consumer, automotive, and industrial electronics.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <pdf:Producer>Acrobat Distiller 25.0 (Windows)</pdf:Producer>
         <pdf:Keywords/>
         <xmpMM:DocumentID>uuid:76ad5330-91e8-4480-a547-b2f6a1609001</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:33d8f0d7-408b-4d88-ad50-a053e6f9a730</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
